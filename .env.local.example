# ─── Playwright screenshots (Definition of Done workflow) ───────────────────
# Copie pra .env.local (ignorado pelo git) e preencha.

PLAYWRIGHT_BASE_URL=https://app.coreohub.com

# Conta de super admin (vê painel /super-admin, bypass de RLS em várias telas).
PLAYWRIGHT_ADMIN_EMAIL=
PLAYWRIGHT_ADMIN_PASSWORD=

# Conta de produtor real — use essa pra a maioria dos screenshots, evita o
# bypass de super_admin mascarando bugs de RLS (como o descoberto em 2026-05-22).
PLAYWRIGHT_PRODUTOR_EMAIL=
PLAYWRIGHT_PRODUTOR_PASSWORD=

# Conta de inscrito — pra testar /dashboard, /minhas-coreografias e fluxos
# de quem se inscreve no festival (não produtor). RLS de inscrito é mais
# restritiva que produtor — boa pra flagrar bugs de visibilidade.
PLAYWRIGHT_INSCRITO_EMAIL=
PLAYWRIGHT_INSCRITO_PASSWORD=

# ─── Frontend (já configurado) ──────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
